[Unit]
Description=Mindflayer Elderbrain installed release container stack
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mindflayer-elderbrain
ExecStartPre=/opt/mindflayer-elderbrain/prepare-admin
ExecStart=/usr/bin/docker compose --env-file appliance.env -f compose.yaml up -d --no-build --pull never --remove-orphans --wait --wait-timeout 120
ExecStartPost=/usr/bin/systemctl --no-block start elderbrain-graphics.service
ExecStop=/usr/bin/docker compose --env-file appliance.env -f compose.yaml down
TimeoutStartSec=300
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
