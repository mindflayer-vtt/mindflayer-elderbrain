[Unit]
Description=Elderbrain native Wayland kiosk
After=elderbrain-stack.service systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service
Requires=elderbrain-stack.service elderbrain-baseline.service
After=elderbrain-baseline.service
Requires=elderbrain-display-watchdog.service
After=elderbrain-display-watchdog.service
OnFailure=elderbrain-graphics-failure.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
User=elderbrain-kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=XDG_RUNTIME_DIR=/run/elderbrain-kiosk
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStartPre=/opt/mindflayer-elderbrain/wait-ready
ExecStartPre=+/usr/bin/python3 /opt/mindflayer-elderbrain/prepare-browser.py
ExecStartPre=+/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/sway --config /run/elderbrain-browser/sway.conf
Restart=always
RestartSec=2
RuntimeDirectory=elderbrain-kiosk
RuntimeDirectoryMode=0700

[Install]
WantedBy=graphical.target
