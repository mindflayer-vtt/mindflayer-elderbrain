[Unit]
Description=Elderbrain pending network confirmation HTTPS listener
Requires=elderbrain-network-recovery.service
After=elderbrain-network-recovery.service network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mindflayer-elderbrain/network_listener.py
Restart=always
RestartSec=1
TimeoutStopSec=5
KillMode=control-group
RuntimeDirectory=elderbrain-network-confirmation
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
